# Environment and credentials
.env
myenv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- Per-regulation data (large / regenerable — NEVER commit) ---
# Each regulation lives in regulations/<slug>/. We commit only its two small
# config files (analyzer_config.yaml + regulation_metadata.json); everything
# else in the dir is data or output and stays local.
attachments/
*.csv
# The reviewed evaluation labels. Every other CSV here is regenerable; this one
# holds hand-checked judgements that cannot be re-derived, and it is the source
# the published accuracy figures are computed from.
!**/eval/candidates.csv
*.parquet
index.html
read-the-rule.html
accuracy.html
*.log

# JSON is ignored by default; re-include the small shared/config JSON.
*.json
!column_mapping.json
!regulation_metadata.json
# The pipeline-maintained changelog history — small, not regenerable, keep it.
!data_changelog.json
# The parsed proposed-rule text behind read-the-rule.html (~140 KB, changes only
# if the rule itself does). It was ignored and not synced from R2, so CI
# checkouts never had it and every automated deploy silently dropped the page
# AND the link to it. Committing it is what makes the rule page reproducible in
# CI without a Federal Register fetch on every publish.
!rule_sections.json
# The evaluation scores behind accuracy.html — same reasoning as rule_sections
# above. index.html only renders the "How accurate is this?" callout when this
# file is present, so a CI checkout without it would quietly publish a report
# with no accuracy page and no link to one.
!**/eval/scores.json
# The record of comments the agency withdrew after publication, and the cursor
# that finds them. A withdrawn comment is blanked in the bulk export — body,
# name, city, tracking number all gone — so this file holds the only remaining
# copy of what was removed and cannot be regenerated from any source. It is also
# load-bearing the same way rule_sections.json is: generate_report.py raises when
# a file named by id_list_flags is missing, so a CI checkout without it fails the
# publish outright rather than quietly dropping the flag.
!withdrawn_comments.json
!withdrawn_check_state.json
# Raw model drafts for the eval set are an API-response cache, not a record.
**/eval/candidates_labeled.jsonl

# Test/report artifacts
test_*.html
test_report.html
posting_lag.html

# Local backlog view for OMB-2026-0034 (which receipt dates have nothing posted
# yet). Not part of the published report and not deployed.
waiting-on.html
build_waiting_on.py

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Node modules (for frontend tests)
node_modules/

# Local Claude Code notes
READ THIS CLAUDE CODE

# Local Netlify folder
.netlify

# Build artifacts from deploy_report.sh (the gzipped full export; *.csv above
# already covers the uncompressed one).
*.csv.gz
*.gz

# Sharded table rows, written next to comment_detail/ on every report build
# (~30 MB, regenerated wholesale). comment_detail/ is already covered by *.json;
# these sidecars are .js, so they need their own line.
comment_rows/

# local-only: describes deploy topology and CI secret names; repo is public
CLAUDE.md

# Playwright MCP scratch output from browser-testing the report.
.playwright-mcp/
